{
  "name": "mint",
  "displayName": "Mint",
  "version": "0.1.1",
  "description": "A work journal your coding agent keeps for you. Claude Code writes worklogs, tasks and costs to Mint; you read one dashboard across every project.",
  "author": {
    "name": "Mint",
    "url": "https://verymint.app"
  },
  "homepage": "https://verymint.app",
  "repository": "https://github.com/verymint/claude-plugin",
  "license": "MIT",
  "privacyPolicyUrl": "https://verymint.app/privacy",
  "termsOfServiceUrl": "https://verymint.app/terms",
  "supportUrl": "https://github.com/verymint/claude-plugin/issues",
  "documentationUrl": "https://github.com/verymint/claude-plugin#readme",
  "icon": "./.claude-plugin/icon.svg",
  "keywords": [
    "worklog",
    "journal",
    "tasks",
    "mcp",
    "productivity"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Mint API key",
      "description": "Create one at https://verymint.app/work (Connect → API keys). Starts with mint_sk_.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "mint": {
      "type": "http",
      "url": "https://verymint.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
